#!/user/bin/env groovy
library identifier: 'jenkins-shared-library@master', retriever: modernSCM(
        [$class: 'GitSCMSource',
        remote: 'https://github.com/sailokesh507/jenkins-shared-library.git',
        credentialsId: 'git'])
)
def gv
pipeline{
    agent any
    tools{
        maven 'maven-3.9'
    }
    stages{
        stage("init"){
            steps{
                script{
                    gv = load "script.groovy"
                }
            }
        }
        stage("build jar"){
            steps{
                script{
                    buildJar() 
                }
            }
        }
        stage("build image"){
            steps{
                script{
                    buildImage('lokesh537/docker:jma-3.4')
                }
            }
        }

        stage("deploy"){
            steps{
                script{
                    gv.deployApp()
                }
            }
        }
    }
}
